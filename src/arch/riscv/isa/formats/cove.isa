def template CoveMttpWriteDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
    };
}};
def template CoveMttpWriteConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    { }
}};

def template CoveMttpWriteExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        auto val = xc->getRegOperand(this, 1); // rs1
        xc->setMiscReg(MISCREG_MTTP, val);     // set mttp
        return NoFault;
    }
}};

def template CoveMttpReadDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
    };
}};

def template CoveMttpReadConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    { }
}};

def template CoveMttpReadExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        auto val = xc->readMiscReg(MISCREG_MTTP); // get mttp
        xc->setRegOperand(this, 0, val);          // write to rd
        return NoFault;
    }
}};